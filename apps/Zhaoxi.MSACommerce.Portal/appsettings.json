{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "itemRoute": {
        "ClusterId": "item",
        "Match": {
          "Path": "/item/{**.html}"
        }
      }
    },
    //portal端口8000 正常访问 如果地址是/item/xxx.html 就会转发到9880端口的服务上
    "Clusters": {
      "item": {
        "Destinations": {
          "item/destination1": {
            "Address": "http://localhost:9880/"
          }
        }
      }
    }
  }
}
