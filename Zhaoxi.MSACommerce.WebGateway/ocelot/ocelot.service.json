
{
  "_comment": "用户服务",
  "Routes": [
    {
      "Key": "UserService",
      "_comment": "路由唯一标识符",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 5001
        }
      ],
      "DownstreamPathTemplate": "/api/user/{path}",
      "DownstreamScheme": "http",
      
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      
      "UpstreamHttpMethod": [
        "Get",
        "Post",
        "Put",
        "Delete"
      ],
      "UpstreamPathTemplate": "/api/user/{path}"  ,
        "AuthenticationOptions": {
            "AuthenticationProviderKeys": [ "Bearer" ],
            "AllowedScopes": []
        }
    }
  ]
}


