{
  "Routes": [
    {
      "ServiceName": "Zhaoxi.MSACommerce.UserService.HttpApi",
      "DownstreamPathTemplate": "/api/user/test",
      "DownstreamScheme": "http",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UpstreamPathTemplate": "/api/user/test",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "DELETE", "OPTIONS" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ],
        "AllowedScopes": []
      }
    },

    {
      "ServiceName": "Zhaoxi.MSACommerce.UserService.HttpApi",
      "DownstreamPathTemplate": "/api/user/{path}",
      "DownstreamScheme": "http",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UpstreamPathTemplate": "/api/user/{path}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "DELETE", "OPTIONS" ]
    },

    {
      "ServiceName": "Zhaoxi.MSACommerce.CategoryService.HttpApi",
      "DownstreamPathTemplate": "/api/category/{path}",
      "DownstreamScheme": "http",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UpstreamPathTemplate": "/api/category/{path}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "DELETE", "OPTIONS" ]
    }   ,

    {
      "ServiceName": "Zhaoxi.MSACommerce.BrandService.HttpApi",
      "DownstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamScheme": "http",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UpstreamPathTemplate": "/brand/swagger.json",
      "UpstreamHttpMethod": [ "Get" ]
    }
  ]
