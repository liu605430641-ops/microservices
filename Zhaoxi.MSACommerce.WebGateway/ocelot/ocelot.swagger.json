{
  "Routes": [
    {
      "ServiceName": "Zhaoxi.MSACommerce.AuthServer",
      "DownstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamScheme": "http",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UpstreamPathTemplate": "/auth/swagger.json",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "ServiceName": "Zhaoxi.MSACommerce.VerificationServer",
      "DownstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamScheme": "http",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UpstreamPathTemplate": "/verification/swagger.json",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "ServiceName": "Zhaoxi.MSACommerce.UserService.HttpApi",
      "DownstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamScheme": "http",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UpstreamPathTemplate": "/user/swagger.json",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "ServiceName": "Zhaoxi.MSACommerce.CategoryService.HttpApi",
      "DownstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamScheme": "http",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UpstreamPathTemplate": "/category/swagger.json",
      "UpstreamHttpMethod": [ "Get" ]
    }        ,

    {
      "ServiceName": "Zhaoxi.MSACommerce.BrandService.HttpApi",
      "DownstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamScheme": "http",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UpstreamPathTemplate": "/brand/swagger.json",
      "UpstreamHttpMethod": [ "Get" ]
    }
  ]
}
